<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld duplicates</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld doppelt</string>
			<key>other</key>
			<string>%lld doppelt</string>
		</dict>
	</dict>
	<key>%lld files skipped, file type not supported</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei übersprungen, Dateityp wird nicht unterstützt</string>
			<key>other</key>
			<string>%lld Dateien übersprungen, Dateityp wird nicht unterstützt</string>
		</dict>
	</dict>
	<key>%lld files skipped, file type not supported yet: %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld Datei übersprungen, Dateityp wird noch nicht unterstützt: %2$@</string>
			<key>other</key>
			<string>%1$lld Dateien übersprungen, Dateityp wird noch nicht unterstützt: %2$@</string>
		</dict>
	</dict>
	<key>%lld rides</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Fahrt</string>
			<key>other</key>
			<string>%lld Fahrten</string>
		</dict>
	</dict>
	<key>%lld rides imported</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Fahrt importiert</string>
			<key>other</key>
			<string>%lld Fahrten importiert</string>
		</dict>
	</dict>
	<key>%lld rides · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Fahrt · %@</string>
			<key>other</key>
			<string>%lld Fahrten · %@</string>
		</dict>
	</dict>
	<key>It holds %lld rides.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Sie enthält %lld Fahrt.</string>
			<key>other</key>
			<string>Sie enthält %lld Fahrten.</string>
		</dict>
	</dict>
</dict>
</plist>
