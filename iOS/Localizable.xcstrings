            "value" : "Für die Kalorien"
          }
        }
      }
    },
    "You set these on the Mac under Profile; with iCloud they come to this iPhone. Editing them here comes with a later version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Angaben machst du am Mac unter „Profil“; mit iCloud kommen sie auf dieses iPhone. Bearbeiten lassen sie sich hier mit einer späteren Version."
          }
        }
      }
    },
    "Wattspur on the iPhone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur auf dem iPhone"
          }
        }
      }
