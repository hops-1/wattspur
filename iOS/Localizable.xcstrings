            "value" : "Gerät löschen"
          }
        }
      }
    },
    "Delete this device?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät löschen?"
          }
        }
      }
    },
    "It disappears on all your devices. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es verschwindet auf allen deinen Geräten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "To delete it, assign all its rides (%lld) to another device first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Löschen weise erst alle seine Fahrten (%lld) einem anderen Gerät zu."
          }
        }
      }
    },
    "All Bikes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bikes"
          }
        }
      }
    },
    "All Shoes" : {
