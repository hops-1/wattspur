    "Questions and Answers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragen und Antworten"
          }
        }
      }
    },
    "The handbook is online, so it can get better between versions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Handbuch ist online, damit es auch zwischen zwei Versionen besser werden kann."
