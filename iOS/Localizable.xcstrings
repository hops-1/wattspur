            "value" : "Für welches Fahrzeug?"
          }
        }
      }
    },
    "Vehicle Type" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahrzeugart"
          }
        }
      }
    },
    "For a bike or vehicle that is not yours. A bicycle ride counts in the cycling totals but towards none of your bikes; a car or motorcycle ride does not count in them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein Rad oder Fahrzeug, das nicht deins ist. Eine Fahrt mit dem Fahrrad zählt in die Rad-Summen, aber zu keinem deiner Bikes; eine Fahrt mit Auto oder Motorrad zählt dort nicht."
          }
        }
      }
    },
    "%@ (vehicle type only)" : {
