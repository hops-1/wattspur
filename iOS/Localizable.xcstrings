            "value" : "Weiß"
          }
        }
      }
    },
    "Without iCloud, the rides stay on this iPad. They reach the Mac with “Share GPX”, e.g. by AirDrop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
