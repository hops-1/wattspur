    "Map Sources" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen der Karten"
          }
        }
      }
    },
    "Apple shows its credit on the map itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple zeigt seine Quellenangabe in der Karte selbst."
          }
        }
      }
    },
    "Privacy Policy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        }
      }
    },
    "Wattspur has no server and no account. Your rides stay on your devices and in your own iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur hat keinen Server und kein Konto. Deine Fahrten bleiben auf deinen Geräten und in deinem eigenen iCloud."
          }
        }
      }
    },
    "Empty Trash" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papierkorb leeren"
          }
        }
      }
    },
    "%lld new" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
