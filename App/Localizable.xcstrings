    "Updates:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates:"
          }
        }
      }
    },
    "Use “Download FIT”: it has power and cadence, the GPX only the route. GPX files from other bikes and bike computers are imported as well." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm „FIT herunterladen“: Es enthält Leistung und Trittfrequenz, die GPX nur die Route. GPX-Dateien anderer Bikes und Radcomputer werden ebenfalls importiert."
          }
        }
      }
    },
