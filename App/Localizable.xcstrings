    "Wattspur %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur %@"
          }
        }
      }
    },
    "Wattspur %@ is available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur %@ ist verfügbar"
          }
        }
      }
    },
    "Wattspur analyses the rides you export from the Bosch eBike Flow app – locally on your Mac, without an account or subscription." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur wertet die Fahrten aus, die du aus der Bosch eBike Flow App exportierst – lokal auf deinem Mac, ohne Konto und ohne Abo."
          }
        }
      }
    },
    "Wattspur can watch a folder and import new exports automatically. With iCloud Drive this works straight from your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur kann einen Ordner beobachten und neue Exporte automatisch übernehmen. Mit iCloud Drive geht das direkt vom iPhone aus."
          }
        }
      }
    },
    "Wattspur could not reach GitHub. Check your internet connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur konnte GitHub nicht erreichen. Prüfe deine Internetverbindung und versuche es noch einmal."
          }
        }
      }
    },
    "Wattspur could not remember this folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur konnte sich diesen Ordner nicht merken."
          }
        }
      }
    },
    "Wattspur follows the macOS language. To use a different language for Wattspur only, go to System Settings › General › Language & Region › Applications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur folgt der Sprache von macOS. Eine eigene Sprache nur für Wattspur stellst du in den Systemeinstellungen unter Allgemein › Sprache & Region › Apps ein."
          }
        }
      }
    },
    "Wattspur Goals" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur Ziele"
          }
        }
      }
    },
    "Wattspur Handbook" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur-Handbuch"
          }
        }
      }
    },
    "Wattspur is not a product of Robert Bosch GmbH and is not affiliated with it. Bosch and eBike Flow are trademarks of their respective owners." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur ist kein Produkt der Robert Bosch GmbH und steht in keiner Verbindung zu ihr. Bosch und eBike Flow sind Marken ihrer jeweiligen Inhaber."
          }
        }
      }
    },
    "Wattspur is up to date" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur ist aktuell"
          }
        }
      }
    },
    "Wattspur now analyses several eBikes separately. All your earlier rides belong to “%@” – rename it and add more bikes in Profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur wertet jetzt mehrere eBikes getrennt aus. Alle bisherigen Fahrten gehören zu „%@“ – benenne es um und lege weitere Bikes im Profil an."
          }
        }
      }
    },
    "Wattspur quits and replaces the library with the backup the next time you open it. Rides and changes since the backup are not in it. The current library is kept in a folder beside it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur beendet sich und ersetzt die Mediathek beim nächsten Öffnen durch das Backup. Fahrten und Änderungen seit dem Backup sind darin nicht enthalten. Die aktuelle Mediathek bleibt in einem Ordner daneben erhalten."
          }
        }
      }
    },
    "Wattspur Records" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wattspur Rekorde"
