// Copy this file to Config/Local.xcconfig (it is ignored by git) and enter your team.
// The Team ID of a free Apple ID ("Personal Team") is shown in Xcode under
// Settings → Apple Accounts, or in Keychain Access in the certificate "Apple Development: …" (OU).
// See docs/learning for the guide "Wattspur aufs iPhone".
DEVELOPMENT_TEAM = ABCDE12345

// Mac app with the paid developer account (B-215, docs/RELEASE.md). Without these lines the Mac app
// stays ad hoc signed, without iCloud, and scripts/build-dmg.sh builds the DMG as before.
// WATTSPUR_MAC_SIGN_STYLE = Automatic
// WATTSPUR_MAC_SIGN_IDENTITY = Apple Development
// WATTSPUR_MAC_ENTITLEMENTS = App/Wattspur-iCloud.entitlements
// scripts/build-dmg.sh: sign with Developer ID and notarize. The password for notarytool is not here
// but in the keychain, saved once under this name with "xcrun notarytool store-credentials".
// WATTSPUR_MAC_DISTRIBUTION = developer-id
// WATTSPUR_NOTARY_PROFILE = wattspur-notary

// iPhone app (B-216, docs/learning/33-iphone-datenbank.md): where its rides come from. Without the line
// it is "folder" as in iOS 0.2. "local" tries the iPhone's own store in the simulator; "icloud" needs the
// developer account and the entitlements.
// WATTSPUR_IOS_DATABASE = local
// WATTSPUR_IOS_DATABASE = icloud
// WATTSPUR_IOS_ENTITLEMENTS = iOS/Wattspur-iOS-iCloud.entitlements
