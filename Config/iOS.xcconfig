// Build settings of the iPhone app (B-204). The signing team is personal and stays out of the
// repository: copy Local.xcconfig.example to Local.xcconfig and enter your team there.
// Without that file the project still generates and builds for the simulator.
// Version and build number of the iPhone app and its widget extension, in one place: App Store
// Connect rejects an upload whose extension differs from the app (R-04). The build number must be
// higher than the last TestFlight upload (0.5.1 build 7).
MARKETING_VERSION = 0.7.0
CURRENT_PROJECT_VERSION = 21

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
// The simulator needs no team: sign to run locally.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

// Whether the iPhone's store syncs (B-216, `PhoneDatabase.Mode`): "local" is the iPhone's own store
// without iCloud. With the developer account Local.xcconfig chooses "icloud" together with the iCloud
// entitlements:
//   WATTSPUR_IOS_DATABASE = icloud
//   WATTSPUR_IOS_ENTITLEMENTS = iOS/Wattspur-iOS-iCloud.entitlements
// Both files hold the App Group the widget reads (B-224); it needs the paid developer account.
// The folder of iOS 0.2 ("folder") ended with 0.6 (B-263).
WATTSPUR_IOS_DATABASE = local
WATTSPUR_IOS_ENTITLEMENTS = iOS/Wattspur-iOS.entitlements

#include? "Local.xcconfig"

CODE_SIGN_ENTITLEMENTS = $(WATTSPUR_IOS_ENTITLEMENTS)
