// Signing of the Mac app (NFR-18, B-215). Without Config/Local.xcconfig, or without the Mac lines
// in it, the app is signed ad hoc as before and has no iCloud access. With the developer account
// Local.xcconfig switches to Developer ID and the entitlements with the iCloud container
// (template: Local.xcconfig.example, steps: docs/RELEASE.md).
// The version of the Mac app; scripts/build-dmg.sh reads it from here (R-12). The build number
// counts the commits and comes from the script.
MARKETING_VERSION = 1.8.15

WATTSPUR_MAC_SIGN_STYLE = Manual
WATTSPUR_MAC_SIGN_IDENTITY = -
WATTSPUR_MAC_ENTITLEMENTS = App/Wattspur.entitlements

#include? "Local.xcconfig"

CODE_SIGN_STYLE = $(WATTSPUR_MAC_SIGN_STYLE)
CODE_SIGN_IDENTITY = $(WATTSPUR_MAC_SIGN_IDENTITY)
CODE_SIGN_ENTITLEMENTS = $(WATTSPUR_MAC_ENTITLEMENTS)
